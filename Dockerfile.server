FROM node:22-slim AS build

WORKDIR /app

# Prisma 在 Debian slim 上需要 openssl；保留基础镜像的官方软件源，避免跨地域镜像不可达。
RUN apt-get update \
    && apt-get install -y --no-install-recommends openssl ca-certificates \
    && rm -rf /var/lib/apt/lists/*

ENV DATABASE_URL="mysql://schema-build:schema-build@mysql:3306/schema-build"

# 先装依赖（利用构建缓存）
COPY server/package.json server/package-lock.json ./
RUN npm ci --no-audit --no-fund

# 使用生产 MySQL schema 并生成 Prisma Client
COPY server/prisma ./prisma
RUN cp prisma/schema.mysql.prisma prisma/schema.prisma && npx prisma generate

COPY server/tsconfig.json server/tsconfig.seed.json ./
COPY server/src ./src
RUN npm run build
RUN npm run build:seed

FROM node:22-slim AS runtime

WORKDIR /app

RUN apt-get update \
    && apt-get install -y --no-install-recommends openssl ca-certificates tar \
    && rm -rf /var/lib/apt/lists/*

ENV NODE_ENV=production
ENV DATABASE_URL="mysql://coffee:runtime-placeholder@mysql:3306/coffee_os"
ENV PORT=3000

COPY server/package.json server/package-lock.json ./
COPY --from=build /app/prisma ./prisma
RUN npm ci --omit=dev --no-audit --no-fund && npx prisma generate

COPY --from=build /app/dist ./dist
COPY --from=build /app/dist-seed ./dist-seed
RUN mkdir -p /app/uploads && chown -R node:node /app

USER node

EXPOSE 3000

# 生产启动只应用已提交的版本化迁移；种子数据由部署脚本显式初始化。
CMD ["sh", "-c", "npx prisma migrate deploy && node dist/index.js"]
