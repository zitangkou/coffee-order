FROM node:22-alpine

WORKDIR /app

# Prisma 在 alpine 上需要 openssl
RUN apk add --no-cache openssl

ENV NODE_ENV=production
ENV DATABASE_URL="mysql://coffee:coffee123@mysql:3306/coffee_os"
ENV PORT=3000

# 先装依赖（利用构建缓存）
COPY server/package.json server/package-lock.json ./
RUN npm install --no-audit --no-fund

# 使用生产 MySQL schema 并生成 Prisma Client
COPY server/prisma ./prisma
RUN cp prisma/schema.mysql.prisma prisma/schema.prisma && npx prisma generate

COPY server/tsconfig.json ./
COPY server/src ./src

EXPOSE 3000

# 启动前自动建表 + 写入种子数据（幂等），然后运行服务
CMD ["sh", "-c", "npx prisma db push --accept-data-loss && npm run seed && node --import tsx src/index.ts"]
