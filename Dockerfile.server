FROM node:22-slim

WORKDIR /app

# Prisma 在 Debian slim 上需要 openssl；使用腾讯云镜像源避免国内拉包卡死
RUN sed -i 's|deb.debian.org|mirrors.cloud.tencent.com|g' /etc/apt/sources.list.d/debian.sources 2>/dev/null; \
    sed -i 's|deb.debian.org|mirrors.cloud.tencent.com|g' /etc/apt/sources.list 2>/dev/null; \
    apt-get update \
    && apt-get install -y --no-install-recommends openssl ca-certificates \
    && rm -rf /var/lib/apt/lists/*

ENV NODE_ENV=production
ENV DATABASE_URL="mysql://coffee:coffee123@mysql:3306/coffee_os"
ENV PORT=3000

# 先装依赖（利用构建缓存）
COPY server/package.json server/package-lock.json ./
# NODE_ENV=production 下 npm 默认跳过 devDependencies，
# 而 tsx/prisma CLI 都在 devDependencies 中，必须显式包含
RUN npm install --no-audit --no-fund --include=dev

# 使用生产 MySQL schema 并生成 Prisma Client
COPY server/prisma ./prisma
RUN cp prisma/schema.mysql.prisma prisma/schema.prisma && npx prisma generate

COPY server/tsconfig.json ./
COPY server/src ./src

EXPOSE 3000

# 启动前自动建表 + 写入种子数据（幂等），然后运行服务
CMD ["sh", "-c", "npx prisma db push --accept-data-loss && npm run seed && node --import tsx src/index.ts"]
