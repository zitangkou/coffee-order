# 本地开发（SQLite）；生产环境切换为 mysql://coffee:coffee123@127.0.0.1:3306/coffee_os
DATABASE_URL="file:./dev.db"
JWT_SECRET="please-change-me"
PORT=3000
# H5 前端地址，用于生成桌码二维码链接
WEB_BASE_URL="http://localhost:5173"
# 是否开启模拟支付（H5 开发阶段）
MOCK_PAYMENT="true"
# 是否自动打印（对接云打印机后开启）
PRINTER_ENABLED="false"
# 安全：限流开关与阈值（生产保持 false 开启限流）
RATE_LIMIT_DISABLED="false"
API_RATE_LIMIT="300"
LOGIN_RATE_LIMIT="5"
# 短信：console 为开发模式（验证码打印到日志/接口返回），生产接入后改为 aliyun/tencent
SMS_PROVIDER="console"
# 微信支付 v3（接入支付时配置；未配置时支付回调一律拒绝）
WECHAT_API_V3_KEY=""
WECHAT_PLATFORM_CERT_PATH=""
