{
  "name": "coffee-order-server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build:seed": "tsc -p tsconfig.seed.json",
    "dev": "node --import tsx --watch src/index.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "db:push": "prisma db push",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "seed": "node --import tsx prisma/seed.ts",
    "dump:specs": "node --import tsx prisma/dump-specs.ts",
    "migrate:specs": "node --import tsx prisma/migrate-specs.ts",
    "smoke": "node scripts/smoke.mjs",
    "security": "npm run build && node scripts/security.mjs",
    "readiness:wechat": "npm run build && node scripts/wechat-readiness.mjs",
    "test:refund-state": "npm run build && node scripts/refund-state.mjs",
    "test:auth-safety": "npm run build && node scripts/auth-safety.mjs",
    "test:order-safety": "npm run build && node scripts/order-safety.mjs",
    "test:payment-safety": "npm run build && node scripts/payment-safety.mjs",
    "test:business-time": "npm run build && node scripts/business-time-safety.mjs"
  },
  "dependencies": {
    "@prisma/client": "^5.22.0",
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.21.2",
    "express-rate-limit": "^8.6.2",
    "jsonwebtoken": "^9.0.2",
    "multer": "^2.2.0",
    "prisma": "^5.22.0",
    "qrcode": "^1.5.4"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.7",
    "@types/multer": "^2.2.0",
    "@types/node": "^22.10.0",
    "@types/qrcode": "^1.5.5",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  }
}
