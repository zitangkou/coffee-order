generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

enum AdminRole {
  STAFF
  MANAGER
}

enum OrderType {
  DINE_IN
  TAKEOUT
}

enum OrderStatus {
  UNPAID
  PAID
  MAKING
  READY
  COMPLETED
  REFUNDING
  REFUNDED
  CANCELLED
}

enum PayType {
  WECHAT
  BALANCE
}

enum PaymentChannel {
  WECHAT
  MOCK
  BALANCE
}

model Admin {
  id                 Int        @id @default(autoincrement())
  username           String     @unique @db.VarChar(50)
  passwordHash       String     @db.VarChar(255)
  role               AdminRole  @default(STAFF)
  status             String     @default("ACTIVE") @db.VarChar(20)
  mustChangePassword Boolean    @default(false)
  tokenVersion       Int        @default(0)
  createdAt          DateTime   @default(now())
  updatedAt          DateTime   @updatedAt
  refunds            Refund[]
  auditLogs          AuditLog[]
}

model AuditLog {
  id         Int      @id @default(autoincrement())
  adminId    Int?
  admin      Admin?   @relation(fields: [adminId], references: [id])
  action     String   @db.VarChar(50)
  targetType String?  @db.VarChar(50)
  targetId   Int?
  detail     String?  @db.Text
  createdAt  DateTime @default(now())

  @@index([createdAt])
}

model ShopSetting {
  id                   Int      @id @default(1)
  name                 String   @default("Coffee OS") @db.VarChar(100)
  slogan               String?  @db.VarChar(200)
  logoUrl              String?  @db.VarChar(500)
  announcement         String?  @db.VarChar(500)
  businessHours        String?  @db.VarChar(100)
  acceptOrders         Boolean  @default(true)
  dineInEnabled        Boolean  @default(true)
  takeoutEnabled       Boolean  @default(true)
  packFee              Decimal  @default(0) @db.Decimal(10, 2)
  refundEnabled        Boolean  @default(true)
  takeoutPhoneRequired Boolean  @default(false)
  printerConfig        Json?
  updatedAt            DateTime @updatedAt
}

model Category {
  id        Int       @id @default(autoincrement())
  name      String    @db.VarChar(50)
  sortOrder Int       @default(0)
  isActive  Boolean   @default(true)
  createdAt DateTime  @default(now())
  products  Product[]
}

model Product {
  id          Int                @id @default(autoincrement())
  categoryId  Int
  category    Category           @relation(fields: [categoryId], references: [id])
  name        String             @db.VarChar(100)
  nameEn      String?            @db.VarChar(100)
  description String?            @db.Text
  flavorNotes String?            @db.VarChar(200)
  origin      String?            @db.VarChar(100)
  roastLevel  String?            @db.VarChar(50)
  imageUrl    String?            @db.VarChar(500)
  price       Decimal            @db.Decimal(10, 2)
  isSignature Boolean            @default(false)
  isHot       Boolean            @default(false)
  isSoldOut   Boolean            @default(false)
  isActive    Boolean            @default(true)
  sortOrder   Int                @default(0)
  createdAt   DateTime           @default(now())
  updatedAt   DateTime           @updatedAt
  orderItems  OrderItem[]
  specGroups  ProductSpecGroup[]

  @@index([categoryId, isActive])
}

model SpecGroup {
  id        Int                @id @default(autoincrement())
  name      String             @unique @db.VarChar(50)
  type      String             @default("SINGLE") @db.VarChar(20)
  sortOrder Int                @default(0)
  isActive  Boolean            @default(true)
  createdAt DateTime           @default(now())
  updatedAt DateTime           @updatedAt
  options   SpecOption[]
  products  ProductSpecGroup[]
}

model SpecOption {
  id         Int       @id @default(autoincrement())
  groupId    Int
  group      SpecGroup @relation(fields: [groupId], references: [id])
  label      String    @db.VarChar(100)
  extraPrice Decimal   @default(0) @db.Decimal(10, 2)
  isDefault  Boolean   @default(false)
  sortOrder  Int       @default(0)
  isActive   Boolean   @default(true)
  createdAt  DateTime  @default(now())

  @@index([groupId])
}

model ProductSpecGroup {
  id          Int       @id @default(autoincrement())
  productId   Int
  product     Product   @relation(fields: [productId], references: [id])
  specGroupId Int
  specGroup   SpecGroup @relation(fields: [specGroupId], references: [id])
  required    Boolean   @default(true)
  sortOrder   Int       @default(0)

  @@unique([productId, specGroupId])
}

model TableInfo {
  id        Int      @id @default(autoincrement())
  tableNo   String   @unique @db.VarChar(20)
  qrCodeUrl String?  @db.VarChar(500)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  orders    Order[]
}

model User {
  id              Int              @id @default(autoincrement())
  openid          String?          @unique @db.VarChar(64)
  wxOpenid        String?          @unique @db.VarChar(64)
  phone           String?          @db.VarChar(20)
  phoneVerified   Boolean          @default(false)
  nickname        String?          @db.VarChar(50)
  avatar          String?          @db.VarChar(500)
  status          String           @default("ACTIVE") @db.VarChar(20)
  tokenVersion    Int              @default(0)
  deletedAt       DateTime?
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  orders          Order[]
  memberAccount   MemberAccount?
  walletLogs      WalletLog[]
  rechargeRecords RechargeRecord[]
  subscribes      UserSubscribe[]
}

model UserSubscribe {
  id         Int      @id @default(autoincrement())
  userId     Int
  user       User     @relation(fields: [userId], references: [id])
  templateId String   @db.VarChar(100)
  status     String   @default("ACCEPTED") @db.VarChar(20)
  createdAt  DateTime @default(now())

  @@unique([userId, templateId])
}

model SmsCode {
  id        Int       @id @default(autoincrement())
  phone     String    @db.VarChar(20)
  code      String    @db.VarChar(64)
  attempts  Int       @default(0)
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([phone])
}

model Order {
  id              Int         @id @default(autoincrement())
  orderNo         String      @unique @db.VarChar(32)
  pickupNo        String      @db.VarChar(10)
  pickupKey       String?     @unique @db.VarChar(32)
  businessDate    String?     @db.Char(8)
  clientRequestId String?     @db.VarChar(64)
  userId          Int?
  user            User?       @relation(fields: [userId], references: [id])
  tableId         Int?
  table           TableInfo?  @relation(fields: [tableId], references: [id])
  orderType       OrderType   @default(DINE_IN)
  status          OrderStatus @default(UNPAID)
  totalAmount     Decimal     @db.Decimal(10, 2)
  packFee         Decimal     @default(0) @db.Decimal(10, 2)
  remark          String?     @db.VarChar(255)
  phone           String?     @db.VarChar(20)
  payType         PayType     @default(WECHAT)
  paidAt          DateTime?
  refundedAt      DateTime?
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt
  items           OrderItem[]
  payments        Payment[]
  refunds         Refund[]

  @@unique([userId, clientRequestId])
  @@index([status, createdAt])
}

model DailySequence {
  businessDate String   @id @db.Char(8)
  pickupValue  Int      @default(0)
  updatedAt    DateTime @updatedAt
}

model OrderItem {
  id          Int     @id @default(autoincrement())
  orderId     Int
  order       Order   @relation(fields: [orderId], references: [id])
  productId   Int
  product     Product @relation(fields: [productId], references: [id])
  productName String  @db.VarChar(100)
  specsDetail Json
  unitPrice   Decimal @db.Decimal(10, 2)
  quantity    Int     @default(1)
  subtotal    Decimal @db.Decimal(10, 2)

  @@index([orderId])
}

model Payment {
  id            Int            @id @default(autoincrement())
  orderId       Int            @unique
  order         Order          @relation(fields: [orderId], references: [id])
  transactionId String?        @unique @db.VarChar(64)
  amount        Decimal        @db.Decimal(10, 2)
  status        String         @default("SUCCESS") @db.VarChar(20)
  channel       PaymentChannel @default(MOCK)
  createdAt     DateTime       @default(now())
}

model Refund {
  id             Int         @id @default(autoincrement())
  orderId        Int
  order          Order       @relation(fields: [orderId], references: [id])
  reason         String      @db.VarChar(255)
  status         String      @default("PENDING") @db.VarChar(20)
  statusBefore   OrderStatus @default(PAID)
  outRefundNo    String?     @unique @db.VarChar(64)
  wechatRefundId String?     @db.VarChar(64)
  refundAmount   Decimal?    @db.Decimal(10, 2)
  failureReason  String?     @db.VarChar(255)
  handledBy      Int?
  admin          Admin?      @relation(fields: [handledBy], references: [id])
  rejectReason   String?     @db.VarChar(255)
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @default(now()) @updatedAt
  handledAt      DateTime?

  @@index([status])
}

model MemberAccount {
  id        Int      @id @default(autoincrement())
  userId    Int      @unique
  user      User     @relation(fields: [userId], references: [id])
  balance   Decimal  @default(0) @db.Decimal(10, 2)
  updatedAt DateTime @updatedAt
}

model WalletLog {
  id        Int      @id @default(autoincrement())
  userId    Int
  user      User     @relation(fields: [userId], references: [id])
  type      String   @db.VarChar(20)
  amount    Decimal  @db.Decimal(10, 2)
  createdAt DateTime @default(now())
}

model RechargeRecord {
  id         Int      @id @default(autoincrement())
  userId     Int
  user       User     @relation(fields: [userId], references: [id])
  payAmount  Decimal  @db.Decimal(10, 2)
  giveAmount Decimal  @default(0) @db.Decimal(10, 2)
  status     String   @default("SUCCESS") @db.VarChar(20)
  createdAt  DateTime @default(now())
}
