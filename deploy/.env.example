# 复制为 .env 后按需修改，再执行 ./deploy.sh

# 方案B：仅宿主机内网端口（默认 8080），对外由 Nginx 网关按域名转发
HTTP_PORT=8080

# 对外公开域名（不包含任何微信密钥）
WEB_BASE_URL=https://nagacoffee.site

# 前端调用的 API 地址（默认同源 /api，由 Nginx 反代，一般无需改）
VITE_API_BASE=/api

# 微信小程序必须使用已备案且加入 request 合法域名的 HTTPS API 地址
VITE_MP_API_BASE=https://nagacoffee.site/api
# 商品图片等静态资源域名；不填时自动从 VITE_MP_API_BASE 去掉 /api 推导
VITE_ASSET_BASE=https://nagacoffee.site

# MySQL 密码与 JWT 密钥（上线前务必修改）
MYSQL_PASSWORD=coffee123
MYSQL_ROOT_PASSWORD=root123
JWT_SECRET=please-change-me-in-production

# 生产环境必须为 false；模拟支付仅限本地开发
MOCK_PAYMENT=false

# 允许访问 API 的浏览器来源，多个域名用英文逗号分隔；默认可与 WEB_BASE_URL 相同
CORS_ORIGINS=https://nagacoffee.site

# 云打印机开关（对接飞鹅/易联云后开启）
PRINTER_ENABLED=false

# 未支付订单自动取消时限（分钟）
ORDER_TIMEOUT_MINUTES=15

# 安全：限流（生产保持 false）
RATE_LIMIT_DISABLED=false
TRUST_PROXY_HOPS=2

# 全新数据库首次部署时设为 true，完成后立即改回 false
INITIALIZE_SEED=false
# 仅旧版 db push 已建表的数据库首次切换迁移时设为 true，执行一次后改回 false
BASELINE_EXISTING_DB=false
# HTTPS、UFW 和容器均配置完成后开启；部署结束自动执行只读安全检查
RUN_SERVER_SECURITY_CHECK=false

# 微信支付 v3（接入时配置；未配置时支付回调 fail-closed 拒绝）
# WECHAT_API_V3_KEY=你的32字节APIv3密钥
# WECHAT_PLATFORM_CERT_PATH=/run/secrets/wechatpay_platform_cert.pem

# 微信小程序（Phase 6 接入时配置；未配置时登录/支付/订阅 fail-closed）
# WECHAT_MP_APPID=wx你的小程序AppID
# WECHAT_MP_SECRET=小程序AppSecret
# WECHAT_MCH_ID=微信支付商户号
# WECHAT_MCH_SERIAL=商户API证书序列号
# WECHAT_MCH_PRIVATE_KEY_PATH=/run/secrets/apiclient_key.pem
# WECHAT_REFUND_NOTIFY_URL=https://nagacoffee.site/api/refund/callback
# WECHAT_SUBSCRIBE_TEMPLATE_READY=出餐通知的订阅消息模板ID

# 专项限流（单 IP）
SMS_RATE_LIMIT=10
ORDER_RATE_LIMIT=30
PAYMENT_RATE_LIMIT=20

# 腾讯云服务器拉取镜像慢时启用加速（可选）
# DOCKER_MIRROR=mirror.ccs.tencentyun.com
