# 复制为 .env 后按需修改，再执行 ./deploy.sh

# 方案B：仅宿主机内网端口（默认 8080），对外由 Nginx 网关按域名转发
HTTP_PORT=8080

# 对外访问地址，用于生成桌码（正式为 https://coffee.example.com）
WEB_BASE_URL=http://localhost

# 前端调用的 API 地址（默认同源 /api，由 Nginx 反代，一般无需改）
VITE_API_BASE=/api

# MySQL 密码与 JWT 密钥（上线前务必修改）
MYSQL_PASSWORD=coffee123
MYSQL_ROOT_PASSWORD=root123
JWT_SECRET=please-change-me-in-production

# 生产环境必须为 false；模拟支付仅限本地开发
MOCK_PAYMENT=false

# 允许访问 API 的浏览器来源，多个域名用英文逗号分隔；默认可与 WEB_BASE_URL 相同
# CORS_ORIGINS=https://coffee.example.com

# 云打印机开关（对接飞鹅/易联云后开启）
PRINTER_ENABLED=false

# 未支付订单自动取消时限（分钟）
ORDER_TIMEOUT_MINUTES=15

# 安全：限流（生产保持 false）
RATE_LIMIT_DISABLED=false

# 微信支付 v3（接入时配置；未配置时支付回调 fail-closed 拒绝）
# WECHAT_API_V3_KEY=你的32字节APIv3密钥
# WECHAT_PLATFORM_CERT_PATH=/run/secrets/wechatpay_platform_cert.pem

# 微信小程序（Phase 6 接入时配置；未配置时登录/支付/订阅 fail-closed）
# WECHAT_MP_APPID=wx你的小程序AppID
# WECHAT_MP_SECRET=小程序AppSecret
# WECHAT_MCH_ID=微信支付商户号
# WECHAT_MCH_SERIAL=商户API证书序列号
# WECHAT_MCH_PRIVATE_KEY_PATH=/run/secrets/apiclient_key.pem
# WECHAT_SUBSCRIBE_TEMPLATE_READY=出餐通知的订阅消息模板ID

# 腾讯云服务器拉取镜像慢时启用加速（可选）
# DOCKER_MIRROR=mirror.ccs.tencentyun.com
