# /etc/nginx/sites-available/coffee-admin.conf
# DNS、备案和证书就绪后，将域名替换为实际管理子域名并启用。
server {
    listen 80;
    server_name admin.nagacoffee.site;
    location /.well-known/acme-challenge/ { root /var/www/letsencrypt; }
    location / { return 301 https://$host$request_uri; }
}

server {
    listen 443 ssl http2;
    server_name admin.nagacoffee.site;

    ssl_certificate /etc/letsencrypt/live/admin.nagacoffee.site/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/admin.nagacoffee.site/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;

    add_header Strict-Transport-Security "max-age=31536000; includeSubDomains" always;

    location / {
        proxy_pass http://127.0.0.1:8081;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto https;
    }
}
